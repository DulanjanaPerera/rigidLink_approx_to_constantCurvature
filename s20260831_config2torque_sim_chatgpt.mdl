      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [theta, phi] = IMU2Config(quaternion)
%#codegen
T = quat2rotm(quaternion);

theta= wrapToPi(atan2(T(2,3),T(1,3)));
phi= (acos(T(3,3)));

end
</P>
